# 이 파일을 복사해서 이름을 .env 로 바꾼 뒤 값을 채우세요.
# .env 는 절대 다른 사람에게 보내거나 깃에 올리지 마세요.

# ── 카카오톡 발송 (필수) ────────────────────────────────────────
# 아래 두 값은 같은 화면에 있습니다.
#   developers.kakao.com > finance_report_project
#   > 앱 > 플랫폼 키 > REST API 키 카드의 점 3개 > 수정

# 화면 맨 위의 "REST API 키"
KAKAO_REST_API_KEY=

# 같은 화면 아래쪽 "클라이언트 시크릿" > 카카오 로그인 행의 "코드"
KAKAO_CLIENT_SECRET=

# 아래 세 줄은 step1_auth.py 가 자동으로 채웁니다. 직접 건드리지 마세요.
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=
KAKAO_TOKEN_EXPIRES_AT=

# ── 카드 문장을 만들 모델 (둘 중 하나만 있으면 됩니다) ──────────
# 어느 쪽을 쓸지는 config.py 의 PROVIDER 로 정합니다.

# 무료. aistudio.google.com/apikey 에서 발급.
GEMINI_API_KEY=

# 유료(월 5천원 안팎). console.anthropic.com 에서 발급.
ANTHROPIC_API_KEY=

# ── 카드 배경 사진 (없어도 되지만 있으면 좋습니다) ──────────────
# 무료. pixabay.com 가입 후 pixabay.com/api/docs 에서 즉시 발급.
# 없으면 assets/ 의 고정 사진을 씁니다.
PIXABAY_API_KEY=
